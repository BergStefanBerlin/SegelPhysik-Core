if(SCENARIO STREQUAL "help")
    set(arguments --help)
    set(expected_code 0)
elseif(SCENARIO STREQUAL "build_info")
    set(arguments --build-info)
    set(expected_code 0)
elseif(SCENARIO STREQUAL "error_catalog")
    set(arguments --fehlerdoku)
    set(expected_code 0)
elseif(SCENARIO STREQUAL "no_arguments")
    set(arguments)
    set(expected_code 2)
elseif(SCENARIO STREQUAL "invalid_argument")
    set(arguments --simulate)
    set(expected_code 2)
elseif(SCENARIO STREQUAL "extra_argument")
    set(arguments --help extra)
    set(expected_code 2)
else()
    message(FATAL_ERROR "Unknown CLI test scenario: ${SCENARIO}")
endif()

execute_process(COMMAND "${CLI}" ${arguments}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error
    ENCODING UTF-8)
if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Exit code ${code}, expected ${expected_code}: ${output}${error}")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${error}")
    endif()
    if(SCENARIO STREQUAL "help" AND NOT output MATCHES "Aufruf:")
        message(FATAL_ERROR "Missing usage information: ${output}")
    endif()
    if(SCENARIO STREQUAL "build_info")
        if(NOT output MATCHES "fachliche Gesamtabnahme offen")
            message(FATAL_ERROR "Missing development status: ${output}")
        endif()
        if(INSTRUMENTATION)
            set(expected_flag ja)
        else()
            set(expected_flag nein)
        endif()
        if(NOT output MATCHES "Testinstrumentierung vorbereitet: ${expected_flag}")
            message(FATAL_ERROR "Wrong instrumentation setting: ${output}")
        endif()
    endif()
    if(SCENARIO STREQUAL "error_catalog")
        file(READ "${CATALOG}" expected_catalog)
        # execute_process normalizes Windows line endings in captured stdout.
        string(REPLACE "\r\n" "\n" expected_catalog "${expected_catalog}")
        if(NOT output STREQUAL expected_catalog)
            message(FATAL_ERROR "CLI catalog must match the authoritative JSON file exactly")
        endif()
        string(JSON version GET "${output}" vertragsversion)
        if(NOT version STREQUAL "1")
            message(FATAL_ERROR "Invalid catalog response version")
        endif()
    endif()
else()
    if(NOT output STREQUAL "" OR NOT error MATCHES "Fehler:")
        message(FATAL_ERROR "Invalid arguments must fail explicitly on stderr: ${output}${error}")
    endif()
    if(SCENARIO STREQUAL "invalid_argument")
        set(expected_id CORE-CLI-0002)
    else()
        set(expected_id CORE-CLI-0001)
    endif()
    if(NOT error MATCHES "${expected_id}")
        message(FATAL_ERROR "Wrong diagnostic ID: ${error}")
    endif()
    file(READ "${CATALOG}" catalog)
    string(JSON count LENGTH "${catalog}" fehler)
    math(EXPR last "${count} - 1")
    set(found FALSE)
    foreach(index RANGE ${last})
        string(JSON id GET "${catalog}" fehler ${index} id)
        if(id STREQUAL expected_id)
            string(JSON status GET "${catalog}" fehler ${index} pruefstatus)
            if(NOT status STREQUAL "implementiert")
                message(FATAL_ERROR "Actual diagnostic is not marked implemented")
            endif()
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Actual diagnostic is missing from catalog")
    endif()
endif()
